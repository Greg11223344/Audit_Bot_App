# Copy to server/.env for local dev, or set these as real environment variables in your hosting
# platform's dashboard for production. Never commit a real .env file (it's in .gitignore).

# "production" enables safety checks: refuses to boot with the dev-default SECRET_KEY or
# without an explicit admin password. Leave unset (or "development") for local dev.
AUDIT_BOT_ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUDIT_BOT_SECRET_KEY=

# Postgres connection string. Render/Railway auto-inject this as plain DATABASE_URL when you
# attach their managed Postgres add-on -- you usually don't need to set this one manually.
# AUDIT_BOT_DATABASE_URL=postgresql://user:password@host:5432/dbname

# First-run admin account (only used the very first time the app boots against an empty DB).
AUDIT_BOT_ADMIN_EMAIL=admin@yourcompany.com
AUDIT_BOT_ADMIN_PASSWORD=

# Where uploaded photos and generated PDF reports are stored. Point this at a mounted
# persistent volume in production -- most PaaS platforms wipe the local filesystem on redeploy.
# AUDIT_BOT_STORAGE_DIR=/data/storage
